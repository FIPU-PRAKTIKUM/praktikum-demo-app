# Primjer varijabli okruženja. Kopiraj u .env (koji je u .gitignore) i ispuni.
# Isti .env čitaju i API (make run) i postgres kontejner (docker run --env-file .env).
APP_VERSION=dev

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=promijeni-me
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
