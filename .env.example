# Primjer varijabli okruženja. Kopiraj u .env (koji je u .gitignore) i ispuni.
# Isti .env čitaju API (make run), postgres kontejner i docker compose (compose.yaml).
# U Composeu POSTGRES_HOST i REDIS_URL nadjačava compose.yaml (db, cache).
APP_VERSION=dev

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=promijeni-me
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
